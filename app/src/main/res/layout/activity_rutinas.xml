<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rutina Activa ⚡"
            android:textColor="#50E6F2"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Día 1: Tren Superior &amp; Core"
            android:textColor="#A0A5B0"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#171D27"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Press de Banca Plano"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Series: 4 | Repeticiones: 10-12 | Descanso: 90s"
                android:textColor="#A0A5B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnMarcar1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#00E88F"
                android:minHeight="48dp"
                android:text="Marcar como Hecho"
                android:textColor="#0B0E14"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#171D27"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Dominadas / Jalón al Pecho"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Series: 4 | Repeticiones: 8-10 | Descanso: 90s"
                android:textColor="#A0A5B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnMarcar2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#00E88F"
                android:minHeight="48dp"
                android:text="Marcar como Hecho"
                android:textColor="#0B0E14"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFinalizarEntrenamiento"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#50E6F2"
            android:minHeight="48dp"
            android:text="Finalizar Entrenamiento"
            android:textColor="#0B0E14"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0B0E14">

    <!-- TÍTULO DE LA PANTALLA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rutina Activa ⚡"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#60EFFF"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Día 1: Tren Superior &amp; Core"
        android:textSize="14sp"
        android:textColor="#8B949E"
        android:layout_marginBottom="24dp"/>

    <!-- TARJETA DE EJERCICIO 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#161B22"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Press de Banca Plano"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F0F6FC"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Series: 4 | Repeticiones: 10-12 | Descanso: 90s"
            android:textSize="13sp"
            android:textColor="#8B949E"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCompletar1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marcar como Hecho"
            android:textColor="#0B0E14"
            android:backgroundTint="#00FF87"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- TARJETA DE EJERCICIO 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#161B22"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Dominadas / Jalón al Pecho"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F0F6FC"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Series: 4 | Repeticiones: 8-10 | Descanso: 90s"
            android:textSize="13sp"
            android:textColor="#8B949E"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCompletar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marcar como Hecho"
            android:textColor="#0B0E14"
            android:backgroundTint="#00FF87"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- BOTÓN FINALIZAR RUTINA -->
    <Button
        android:id="@+id/btnTerminarRutina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finalizar Entrenamiento"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#0B0E14"
        android:backgroundTint="#60EFFF"
        android:padding="14dp"/>

</LinearLayout>
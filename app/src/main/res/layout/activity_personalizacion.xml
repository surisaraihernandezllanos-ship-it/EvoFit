<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalización de Tema"
            android:textColor="#50E6F2"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Selecciona la paleta de color para EvoFit:"
            android:textColor="#A0A5B0"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgTemas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#171D27"
            android:orientation="vertical"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rbModoOscuro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="#9060E8"
                android:minHeight="48dp"
                android:text="Modo Oscuro Cyber (#0B0E14)"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbModoClaro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="#9060E8"
                android:minHeight="48dp"
                android:text="Modo Claro Profesional"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbModoDegradado"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="#9060E8"
                android:minHeight="48dp"
                android:text="Modo Degradado Cósmico"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <Button
            android:id="@+id/btnGuardarTema"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00E88F"
            android:minHeight="48dp"
            android:text="Guardar y Aplicar Tema"
            android:textColor="#0B0E14"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
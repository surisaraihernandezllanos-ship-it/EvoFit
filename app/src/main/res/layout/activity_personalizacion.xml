<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutPersonalizacion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0B0E14">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalización de Tema"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#60EFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona la paleta de color para EvoFit:"
        android:textColor="#8B949E"
        android:textSize="15sp"
        android:layout_marginBottom="20dp"/>

    <RadioGroup
        android:id="@+id/rgTemas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <RadioButton
            android:id="@+id/rbOscuro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo Oscuro Cyber (#0B0E14)"
            android:textColor="#F0F6FC"
            android:padding="12dp"/>

        <RadioButton
            android:id="@+id/rbClaro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo Claro Profesional"
            android:textColor="#F0F6FC"
            android:padding="12dp"/>

        <RadioButton
            android:id="@+id/rbDegradado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo Degradado Cósmico"
            android:textColor="#F0F6FC"
            android:padding="12dp"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnAplicarTema"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar y Aplicar Tema"
        android:backgroundTint="#00FF87"
        android:textColor="#0B0E14"
        android:textStyle="bold"
        android:padding="14dp"/>

</LinearLayout>
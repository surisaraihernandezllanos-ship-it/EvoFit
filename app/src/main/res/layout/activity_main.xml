<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0B0E14">

    <!-- LOGO O TÍTULO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EVOFIT"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="#60EFFF"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu plataforma de entrenamiento inteligente"
        android:textSize="14sp"
        android:textColor="#8B949E"
        android:layout_marginBottom="40dp"/>

    <!-- CAMPO USUARIO -->
    <EditText
        android:id="@+id/etUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Correo o Usuario"
        android:textColor="#F0F6FC"
        android:textColorHint="#8B949E"
        android:inputType="textEmailAddress"
        android:padding="16dp"
        android:background="#161B22"
        android:layout_marginBottom="16dp"/>

    <!-- CAMPO CONTRASEÑA -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Contraseña"
        android:textColor="#F0F6FC"
        android:textColorHint="#8B949E"
        android:inputType="textPassword"
        android:padding="16dp"
        android:background="#161B22"
        android:layout_marginBottom="28dp"/>

    <!-- BOTÓN REGISTRO / ACCESO -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comenzar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0B0E14"
        android:backgroundTint="#00FF87"
        android:padding="14dp"/>

</LinearLayout>
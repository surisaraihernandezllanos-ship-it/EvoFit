<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EVOFIT"
        android:textColor="#50E6F2"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="32dp"
        android:text="Tu plataforma de entrenamiento inteligente"
        android:textColor="#A0A5B0"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etUsuario"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#171D27"
        android:hint="Correo o Usuario"
        android:inputType="textEmailAddress"
        android:minHeight="48dp"
        android:paddingHorizontal="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A5B0" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="#171D27"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:paddingHorizontal="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A5B0" />

    <Button
        android:id="@+id/btnComenzar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#00E88F"
        android:minHeight="48dp"
        android:text="Comenzar"
        android:textColor="#0B0E14"
        android:textStyle="bold" />

</LinearLayout>
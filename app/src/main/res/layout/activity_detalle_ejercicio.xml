<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Ejercicio"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGrupoMuscular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Grupo Muscular"
            android:textColor="#50E6F2"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="20dp"
            android:background="#000000">

            <VideoView
                android:id="@+id/videoEjercicio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Instrucciones y Técnica"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInstrucciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="4dp"
            android:text="Descripción paso a paso..."
            android:textColor="#A0A5B0"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnVolverEjercicios"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#00E88F"
            android:minHeight="48dp"
            android:text="Volver a Ejercicios"
            android:textColor="#0B0E14"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
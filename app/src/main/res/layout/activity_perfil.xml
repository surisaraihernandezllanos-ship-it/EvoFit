<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Mi Perfil"
            android:textColor="#50E6F2"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Foto de perfil -->
        <ImageView
            android:id="@+id/imgAvatarPerfil"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:background="#171D27"
            android:contentDescription="Foto de perfil"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces" />

        <Button
            android:id="@+id/btnCambiarFoto"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#9060E8"
            android:minHeight="48dp"
            android:paddingHorizontal="20dp"
            android:text="Cambiar Foto de Perfil"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Correo / Usuario -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo / Usuario:"
            android:textColor="#A0A5B0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#171D27"
            android:hint="Atleta EvoFit"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A0A5B0"
            android:autofillHints="" />

        <!-- Fila de Edad, Peso y Altura -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edad:"
                    android:textColor="#A0A5B0"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEdad"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#171D27"
                    android:hint="20"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#A0A5B0"
                    android:autofillHints="" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Peso (kg):"
                    android:textColor="#A0A5B0"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPeso"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#171D27"
                    android:hint="70.0"
                    android:inputType="numberDecimal"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#A0A5B0"
                    android:autofillHints="" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Altura (cm):"
                    android:textColor="#A0A5B0"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etAltura"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#171D27"
                    android:hint="175"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#A0A5B0"
                    android:autofillHints="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nivel físico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nivel físico:"
            android:textColor="#A0A5B0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etNivelFisico"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#171D27"
            android:hint="Principiante / Intermedio / Avanzado"
            android:inputType="textCapWords"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A0A5B0"
            android:autofillHints="" />

        <!-- Estado de la cuenta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Estado de la cuenta:"
            android:textColor="#A0A5B0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etEstadoCuenta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#171D27"
            android:hint="Activo / Entrenando"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="#00E88F"
            android:textColorHint="#A0A5B0"
            android:autofillHints="" />

        <!-- Botones -->
        <Button
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#00E88F"
            android:minHeight="48dp"
            android:text="Guardar Cambios"
            android:textColor="#0B0E14"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverPerfil"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#171D27"
            android:minHeight="48dp"
            android:text="Volver al Dashboard"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>

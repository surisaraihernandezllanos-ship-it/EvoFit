<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Mi Perfil"
            android:textColor="#50E6F2"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgAvatarPerfil"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="Foto de perfil"
            android:src="@android:drawable/sym_def_app_icon" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo / Usuario:"
            android:textColor="#A0A5B0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#171D27"
            android:hint="Atleta EvoFit"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A0A5B0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Estado de la cuenta:"
            android:textColor="#A0A5B0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etEstadoCuenta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#171D27"
            android:hint="Activo / Entrenando"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="#00E88F"
            android:textColorHint="#A0A5B0" />

        <Button
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00E88F"
            android:minHeight="48dp"
            android:text="Guardar Cambios"
            android:textColor="#0B0E14"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>